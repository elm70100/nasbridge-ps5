+bool is_pkg_entry(const std::string &entry)
+{
+    if (entry.size() < 4)
+        return false;
+    const std::size_t n = entry.size();
+    return entry[n - 4] == '.' &&
+           (entry[n - 3] == 'p' || entry[n - 3] == 'P') &&
+           (entry[n - 2] == 'k' || entry[n - 2] == 'K') &&
+           (entry[n - 1] == 'g' || entry[n - 1] == 'G');
 }
 
